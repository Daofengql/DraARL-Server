# Edge mode deliberately has no Database/Redis/Web section.
Edge:
  NodeID: edge-fuzhou-01
  Center: center.example.com:60100
  DataCenter: center.example.com:60101
  Token: replace-with-one-time-or-issued-node-token
  Listen: :8000
  TLSCAFile: ./center-ca.pem
  TLSServerName: center.example.com
  InsecureSkipVerify: false
