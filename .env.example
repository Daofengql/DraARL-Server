COMPOSE_PROJECT_NAME=draarl
DRAARL_VERSION=dev

# Browser-facing addresses and published host ports.
DRAARL_PUBLIC_URL=http://localhost:9000
DRAARL_HTTP_PORT=9000
DRAARL_UDP_PORT=60050
DRAARL_MINIO_API_PORT=9002
# DraARL 服务和浏览器都必须能访问这个已发布的地址。
DRAARL_MINIO_ENDPOINT=storage.example.com:9002
DRAARL_MINIO_USE_SSL=false

# Replace every value below before exposing the deployment to a network.
DRAARL_MYSQL_PASSWORD=replace_with_a_long_mysql_password
DRAARL_MYSQL_ROOT_PASSWORD=replace_with_a_different_root_password
DRAARL_REDIS_PASSWORD=replace_with_a_long_redis_password
DRAARL_MINIO_ROOT_USER=draarlminio
DRAARL_MINIO_ROOT_PASSWORD=replace_with_a_long_minio_password

# Leave blank to generate once into the persistent DraARL config volume.
DRAARL_JWT_SECRET=
DRAARL_AES_KEY=
DRAARL_AUTO_MIGRATE=true
