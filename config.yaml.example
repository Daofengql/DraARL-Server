# DraARL 配置文件模板
# 复制此文件为 config.yaml 并根据实际情况修改配置

# 系统配置
System:
    Host: ""                   # 监听地址，空则监听所有网卡
    Port: "60050"              # UDP服务端口
    LogPath: ""                # 日志文件路径，空则不输出文件
    IPfile: ./ipinfo.ipdb      # IP数据库文件路径
    ProxyProtocol: ""          # PROXY Protocol 版本: "v2" 启用, 留空禁用。启用后可从 frp 等代理获取真实客户端 IP
    HTTPTrustedProxyCIDRs: []  # HTTP 反代来源；直连保持空。仅列出实际代理 IP/CIDR，控制 X-Forwarded-For/Proto 信任

# UDP 转发性能配置。SendWorkers/IngressWorkers 为 0 时按 CPU 自动选择。
UDP:
    SendWorkers: 0             # 并发发送 FD 数，自动值最多 8；手动值范围 1-32
    IngressWorkers: 0          # 按设备身份分片的处理 worker，自动值最多 16
    DeviceAuthWorkers: 4       # 独立认证 worker，限制同时 bcrypt/DB 认证数；范围 1-16
    DeviceAuthQueueSize: 512   # 每个认证 worker 的排队上限；共享 NAT/FRP 批量重连不受单 IP 硬拒绝
    FrameQueueSize: 64         # 发送队列按完整帧计数；满时淘汰最旧帧
    MaxFrameAgeMS: 120         # 超过该排队时间的实时帧不再发送
    ReadBufferBytes: 4194304   # 请求的 UDP 接收缓冲（实际值以启动日志/指标为准）
    WriteBufferBytes: 4194304  # 请求的 UDP 发送缓冲（实际值以启动日志/指标为准）

# 幽灵设备多端与多收始终启用；这里只配置容量上限。零值使用默认值。
GhostSessions:
    MaxSessionsPerOwner: 8             # 同一账号最多同时在线的幽灵 Session 数
    MaxSubscriptionsPerSession: 16     # 每个幽灵 Session 最多接收的频道数

# 频道消息历史 API 的分页和查询保护。列表与详情共享账号/IP 窗口和并发槽。
MessageAPI:
    DefaultPageSize: 50
    MaxPageSize: 100
    RequestsPerMinutePerUser: 120
    RequestsPerMinutePerIP: 300
    MaxConcurrentQueries: 32

# 固件 OTA 下载兼容。设备发布记录可单独选择 presigned 或 proxy。
# AutoProxy 在预签名地址超过旧版设备 255 字符限制时自动改用服务端代理。
Firmware:
    AutoProxy: true
    MaxPresignedURLLength: 255

# 可选中心群组互联。中心间低频准入走现有 HTTP/HTTPS，实时音频复用主 UDP 端口。
# 在后台“群组管理 → 中心互联”生成邀请或导入对端 Token。
Interconnect:
    Enabled: false
    CenterID: "center-a"       # 每个独立站点使用不同的稳定 ID
    RegistrationTokenTTL: 86400
    CredentialRotationGraceSeconds: 600 # 在线轮换后旧凭据可重连的短时宽限，最大 3600 秒
    SessionRecoveryWindowSeconds: 180   # 中心重启/节点重连时保留旧设备归属的恢复窗口，30-600 秒
    Resources:
        MaxNodes: 256
        MaxPendingHandshakes: 64
        AuthAttemptsPerMinutePerIP: 30
        DataSoftPPSPerNode: 50000       # 软阈值只记录告警，不丢包
        DataHardPPSPerNode: 100000
        DataHardMbpsPerNode: 1000
        DataQueuePerNode: 512
        DataQueueGlobal: 4096
        DataWorkers: 0                  # 0 按 CPU 自动选择（2-16）
        DataMaxQueueAgeMS: 200
        ControlSoftPPSPerNode: 1000
        ControlHardPPSPerNode: 2000
        ControlHardMbpsPerNode: 256
        DeviceAuthPPSPerNode: 500
        MaxDeviceSessionsPerNode: 25000

# MySQL数据库配置
Database:
    Host: "127.0.0.1"
    Port: 3306
    User: "draarl"
    Password: "your_password_here"
    DBName: "draarl"
    Charset: "utf8mb4"
    Collate: "utf8mb4_unicode_ci"
    # Local 保持历史行为；新部署建议显式使用 UTC 或 IANA 时区，使 Go/GORM/MySQL session 一致
    Timezone: "Local"

    # 连接池配置
    MaxOpenConns: 25           # 最大打开连接数
    MaxIdleConns: 5            # 最大空闲连接数
    MaxLifetime: 300           # 连接最大存活时间(秒)

# Redis 配置（release 构建必需；development/test 构建不可用时可降级到内存存储）
Redis:
    Host: "127.0.0.1"
    Port: 6379
    Password: ""
    DB: 0
    Prefix: "draarl"
    DialTimeoutSec: 3
    ReadTimeoutSec: 2
    WriteTimeoutSec: 2
    PoolSize: 20

# Web服务配置
Web:
    Host: ""                   # 监听地址，空则监听所有网卡
    Port: "9000"               # Web服务端口
    FrontendURL: "http://localhost:5173"  # 前端地址，用于SSO回调后重定向
    AllowedOrigins:            # CORS / WS Origin 白名单：填写真正发起 API/WS 请求的页面域名
        - "http://localhost:5173"

# 群组自动播报（仅中心完整模式执行）
Broadcast:
    Enabled: false                 # 站点总开关；由接入射频设备的台站管理员显式启用
    QuietWindowSeconds: 5         # 活动通信域连续静默时间；最近有语音则本轮跳过
    MaxAudioDurationSeconds: 30   # 单条播报上限，服务端硬上限 60 秒
    MaxUploadBytes: 20971520      # 原始音频上传上限（20 MiB）
    TranscodeTimeoutSeconds: 90   # ffprobe + ffmpeg 单任务总超时
    TranscodeMemoryLimitMB: 512   # Linux 子进程地址空间上限；容器还受 /tmp 64 MiB 限制
    TranscodeCPULimitSeconds: 60  # Linux 子进程累计 CPU 时间上限；ffmpeg 固定单线程
    TranscodeWorkers: 2            # 转码并发 worker 数（1-4，注意与内存/CPU 上限配合）
    ScanIntervalMS: 1000          # 到期计划扫描间隔
    RecoveryWindowSeconds: 10     # 重启后允许认领的短暂到期窗口
    ClaimBatchSize: 20            # 每轮最多认领任务数
    FFmpegPath: "ffmpeg"
    FFprobePath: "ffprobe"

# Keycloak SSO 单点登录配置 (可选)
Keycloak:
    Enabled: false                    # 是否启用SSO登录
    Name: "企业SSO"                    # SSO显示名称，用于登录按钮和绑定提示
    BaseURL: "http://localhost:8080"   # Keycloak服务器地址
    Realm: "draarl"                  # Realm名称
    ClientID: "draarl-frontend"      # 客户端ID
    ClientSecret: ""                  # 客户端密钥(如需要)
    RedirectURI: "http://localhost:9000/api/sso/callback"  # 回调地址（后端API）

# 统一存储配置（主块）
# Driver 为空时：若 Storage.MinIO.Endpoint 非空 → minio，否则 local。
# 新部署建议使用 ActiveProfile + Profiles；MinIO 旧配置仍保持兼容。
Storage:
    Driver: ""                        # minio | s3 | r2 | cos | oss | local；空则自动推断
    UploadLimits:
        ClientResourceBytes: 536870912 # 客户端资源直传上限，默认 512 MiB
    Local:
        RootPath: "./data/storage"    # 本地磁盘根目录（已做路径穿越防护）
        BaseURL: ""                   # 公开访问前缀，空则使用 /files
    MinIO:
        Endpoint: "localhost:9000"    # 后端连接 MinIO 的地址
        PublicEndpoint: ""            # 可选，对外预签名地址；容器部署时与内部 Endpoint 分离
        AccessKey: "minioadmin"       # Access Key
        SecretKey: "minioadmin"       # Secret Key
        UseSSL: false                 # 是否使用 HTTPS
        PublicUseSSL: false           # PublicEndpoint 是否使用 HTTPS
        Bucket: "draarl"             # 默认存储桶
        DownloadURLPrefix: ""         # 可选：预签名 GET 的访问前缀；仅供用户自行配置的反向代理使用
    # 统一 S3 兼容配置。Driver=s3/r2/cos/oss 时使用此块。
    S3:
        Provider: ""                  # minio | r2 | cos | oss（标识与文档用途）
        Endpoint: ""                  # 后端 S3 API host:port 或完整 http(s):// URL；scheme 会覆盖 UseSSL
        PresignEndpoint: ""           # 浏览器可访问的 S3 API 地址；空则使用 Endpoint，scheme 会覆盖 PresignUseSSL
        DownloadURLPrefix: ""         # 可选：替换预签名 GET 的 URL 前缀；不影响 PUT，不代表对象公开
        Region: ""                    # R2 留空时自动使用 auto；COS/OSS 必须按 Bucket 地域填写
        BucketLookup: "auto"          # auto | path | dns；非法值会拒绝启动
        AccessKey: ""
        SecretKey: ""
        SessionToken: ""              # 可选 STS 临时凭据
        UseSSL: true
        PresignUseSSL: true
        Bucket: "draarl"
        AutoCreateBucket: false        # 公有云默认由部署侧预先创建 bucket

    # 多 profile 示例。运行时用 ActiveProfile 指定一个 profile；存储迁移可在命令中同时引用任意两个 profile。
    # AccessKey/SecretKey/SessionToken 可写为精确的 ${ENV_NAME}，运行时解析且不会将解析后的密钥写回配置文件。
    # ActiveProfile: "r2-prod"
    # Profiles:
    #     minio-prod:
    #         Driver: s3
    #         S3:
    #             Provider: minio
    #             Endpoint: "minio.internal:9000"
    #             PresignEndpoint: "storage.example.com"
    #             DownloadURLPrefix: "" # 高级选项：用户自管反向代理的下载路径前缀
    #             Region: "us-east-1"
    #             BucketLookup: path
    #             AccessKey: "${MINIO_ACCESS_KEY}"
    #             SecretKey: "${MINIO_SECRET_KEY}"
    #             UseSSL: false
    #             PresignUseSSL: true
    #             Bucket: "draarl"
    #             AutoCreateBucket: true
    #     r2-prod:
    #         Driver: s3
    #         S3:
    #             Provider: r2
    #             Endpoint: "<account-id>.r2.cloudflarestorage.com"
    #             Region: "auto"
    #             BucketLookup: path
    #             AccessKey: "${R2_ACCESS_KEY}"
    #             SecretKey: "${R2_SECRET_KEY}"
    #             UseSSL: true
    #             Bucket: "draarl"
    #             AutoCreateBucket: false
    #     cos-prod:
    #         Driver: cos
    #         S3:
    #             Endpoint: "cos.ap-guangzhou.myqcloud.com"
    #             PresignEndpoint: "cos.ap-guangzhou.myqcloud.com"
    #             Region: "ap-guangzhou"
    #             BucketLookup: dns
    #             AccessKey: "${COS_SECRET_ID}"
    #             SecretKey: "${COS_SECRET_KEY}"
    #             UseSSL: true
    #             PresignUseSSL: true
    #             Bucket: "draarl-<appid>"
    #             AutoCreateBucket: false
    #     oss-prod:
    #         Driver: oss
    #         S3:
    #             Endpoint: "oss-cn-hangzhou.aliyuncs.com"
    #             PresignEndpoint: "oss-cn-hangzhou.aliyuncs.com"
    #             Region: "cn-hangzhou"
    #             BucketLookup: dns
    #             AccessKey: "${OSS_ACCESS_KEY_ID}"
    #             SecretKey: "${OSS_ACCESS_KEY_SECRET}"
    #             UseSSL: true
    #             PresignUseSSL: true
    #             Bucket: "draarl"
    #             AutoCreateBucket: false

# JWT 配置
JWT:
    Secret: ""                         # JWT 签名密钥，至少 32 字符；留空或过短时程序会自动生成并写入配置文件

# 设备认证配置
DeviceAuth:
    AESKey: ""                        # AES 加密密钥，用于设备密码加密存储
                                      # 必须为 16、24 或 32 字节（对应 AES-128/192/256）
                                      # 留空则自动生成 32 字节密钥并写入配置文件
