# syntax=docker/dockerfile:1.7
# Upstream stopped publishing patched community binaries. Build the official
# security release from source and refresh the vulnerable transitive modules.
FROM golang:1.27.3-alpine3.24 AS build
ARG MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z
RUN apk add --no-cache jq
WORKDIR /build
RUN --mount=type=cache,target=/go/pkg/mod \
    source_dir="$(go mod download -json github.com/minio/minio@${MINIO_VERSION} | jq -er .Dir)" && \
    cp -R "${source_dir}" /src && chmod -R u+w /src
WORKDIR /src
RUN --mount=type=cache,target=/go/pkg/mod \
    go get github.com/klauspost/compress@v1.20.3 \
      golang.org/x/crypto@v0.58.1-0.20261009181718-2f1f834330b2 \
      golang.org/x/net@v0.62.0 golang.org/x/sys@v0.49.0 golang.org/x/text@v0.43.0 \
      filippo.io/edwards25519@v1.2.0 github.com/Azure/go-ntlmssp@v0.1.1 \
      github.com/apache/thrift@v0.24.0 github.com/buger/jsonparser@v1.1.2 \
      github.com/eclipse/paho.mqtt.golang@v1.5.1 github.com/go-jose/go-jose/v4@v4.1.6 \
      github.com/prometheus/prometheus@v0.311.3 github.com/rabbitmq/amqp091-go@v1.14.0 \
      go.mongodb.org/mongo-driver@v1.17.7 go.opentelemetry.io/otel/sdk@v1.47.0 \
      google.golang.org/grpc@v1.83.2
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOMAXPROCS=2 go build -mod=mod -p=2 -trimpath \
      -ldflags="-s -w -X github.com/minio/minio/cmd.Version=${MINIO_VERSION} -X github.com/minio/minio/cmd.ReleaseTag=${MINIO_VERSION}" \
      -o /out/minio .
RUN cp LICENSE /out/LICENSE

FROM alpine:3.24
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates tzdata curl && \
    addgroup -S -g 10001 minio && adduser -S -D -H -u 10001 -G minio minio && \
    mkdir /data && chown minio:minio /data
COPY --from=build /out/minio /usr/local/bin/minio
COPY --from=build /out/LICENSE /usr/share/licenses/minio/LICENSE
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.version="RELEASE.2025-10-15T17-29-55Z"
USER minio
EXPOSE 9000
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data"]
